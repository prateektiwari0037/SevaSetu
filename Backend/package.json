{
  "name": "sevasetu-backend",
  "version": "1.0.0",
  "description": "SevaSetu Backend REST API (MongoDB + Mongoose)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seedMongo.js",
    "migrate": "node src/scripts/migratePostgresToMongo.js",
    "verify": "node src/scripts/verifyMigration.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "node src/scripts/seedMongo.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
